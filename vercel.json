{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "builds": [],
  "rewrites": [
    { "source": "/", "destination": "https://api-p7-production.up.railway.app/health" },
    { "source": "/:path*", "destination": "https://api-p7-production.up.railway.app/:path*" }
  ],
  "headers": [
    { "source": "/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
